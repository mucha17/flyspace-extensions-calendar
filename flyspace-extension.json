{
  "$schema": "https://flyspace.flytegration.net/schema/extension/v0.json",
  "compatibleCore": "\u003e=0.3.0",
  "configuration": {
    "userSchema": "./src/config.user.schema.json"
  },
  "contributes": {
    "dashboardWidgets": [
      {
        "component": "DashboardWidget",
        "defaultSize": "medium",
        "id": "calendar-upcoming"
      }
    ],
    "navigation": [
      {
        "component": "MainView",
        "icon": "./assets/icon.svg",
        "id": "calendar-main",
        "label": {
          "en": "Calendar",
          "pl": "Kalendarz"
        },
        "order": 100
      }
    ],
    "notificationTypes": [],
    "settingsPanels": [
      {
        "component": "SettingsPanel",
        "id": "calendar-settings",
        "scope": "user"
      }
    ],
    "threadTypes": []
  },
  "endpoints": {
    "backend": "http://localhost:9090",
    "frontend": {
      "entry": "http://localhost:4201/remoteEntry.json",
      "exposes": {
        "DashboardWidget": "./DashboardWidget",
        "MainView": "./MainView",
        "SettingsPanel": "./SettingsPanel"
      },
      "remoteName": "calendar"
    },
    "health": "/healthz"
  },
  "events": {
    "delivery": "webhook",
    "publishes": [],
    "subscribes": []
  },
  "id": "net.flytegration.calendar",
  "integrity": {
    "bundleHash": "sha384-MNPQaIOq45rjGgdPJqPCaDGPinJFA1jAMRRtYQ87lUJbHf+nZhpcpGU4qcZYclzS",
    "signature": "ZwE7X9P2OsUuVjZpUHgmsYdRFNvjoI0+gaJLp90KxXYYnG7kGj3g9gqaU6wkjNm/NtTXOJM/FFlWNCF0hRvuBA=="
  },
  "manifestVersion": "0",
  "metadata": {
    "author": {
      "email": "hello@flytegration.com",
      "name": "Flytegration",
      "publicKey": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAZ0VgnS92Ns8DjzO1HS7kizVR2M+Tnl4kDVhXA1LGT8g=\n-----END PUBLIC KEY-----\n",
      "url": "https://flytegration.com"
    },
    "description": {
      "en": "A personal calendar for your events — all-day and timed, including multi-day.",
      "pl": "Osobisty kalendarz na Twoje wydarzenia — całodniowe i godzinowe, także wielodniowe."
    },
    "homepage": "https://flytegration.com",
    "icon": "./assets/icon.svg",
    "license": "Apache-2.0",
    "name": {
      "en": "Calendar",
      "pl": "Kalendarz"
    }
  },
  "network": {
    "outbound": []
  },
  "peerRuntime": {
    "@angular/core": "^21.0",
    "flyspaceSdk": "^0.3"
  },
  "permissions": {
    "core": [
      "backend:call"
    ],
    "extensions": [],
    "user": []
  },
  "version": "0.0.1"
}