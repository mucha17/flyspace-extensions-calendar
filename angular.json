{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "template": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "fly",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {},
          "configurations": {
            "production": { "target": "template:esbuild:production" },
            "development": { "target": "template:esbuild:development", "dev": true }
          },
          "defaultConfiguration": "production"
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/template",
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["zone.js", "es-module-shims"],
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "flyspace-extension.json", "input": ".", "output": ".well-known" }]
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "styles": ["src/styles.css", "node_modules/@flyspace/design-tokens/dist/tokens.css"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "template:esbuild:production" },
            "development": { "buildTarget": "template:esbuild:development" }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "template:serve-original:development",
            "rebuildDelay": 0,
            "dev": true,
            "port": 4201
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
